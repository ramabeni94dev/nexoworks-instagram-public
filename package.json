{
  "name": "nexoworks-instagram-public",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "build": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "install:browser": "playwright install chromium",
    "scrape": "node --env-file-if-exists=.env scripts/scrape.mjs",
    "probe": "node --env-file-if-exists=.env scripts/probe-instagram.mjs",
    "extract": "node --env-file-if-exists=.env scripts/extract.mjs",
    "refresh:cloud": "node --env-file-if-exists=.env scripts/refresh-cloud.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@sparticuz/chromium": "^147.0.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.5",
    "cheerio": "^1.2.0",
    "express": "^5.1.0",
    "playwright": "^1.55.0"
  }
}
