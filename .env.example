PORT=3107
# Sin ADMIN_TOKEN, solo escucha en 127.0.0.1 para desarrollo local.
# Obligatorio en producción. Usar una clave aleatoria de al menos 32 caracteres.
ADMIN_TOKEN=
HOST=127.0.0.1
DATA_DIR=./data
CACHE_TTL_MINUTES=60
SCRAPE_TIMEOUT_MS=45000
# Solo para instalaciones que ya tengan Chromium compatible:
# CHROMIUM_EXECUTABLE_PATH=
# Vercel configura estas variables en el proyecto, nunca en archivos públicos:
# BLOB_READ_WRITE_TOKEN=
# CRON_SECRET=
# Servicio publicado en Railway: volumen /data, CACHE_TTL_MINUTES=360.
# Para la extracción como servicio en la nube:
# SCRAPE_PROVIDER=apify
# APIFY_TOKEN=
# APIFY_MAX_CHARGE_USD=0.10
# REFRESH_EXECUTOR=server
# REFRESH_EXECUTOR=external para que el panel guarde pedidos al worker de la PC.
# El worker usa su propio .env.worker con CACHE_TTL_MINUTES=360 y las variables
# BLOB_READ_WRITE_TOKEN y CHROMIUM_EXECUTABLE_PATH. No necesita ADMIN_TOKEN.
